# ---- LLM (any OpenAI-compatible endpoint) -------------------------------
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1  (LLM_API_KEY=ollama)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
# Leave empty to use the built-in default system prompt.
SYSTEM_PROMPT=

# ---- Embeddings -----------------------------------------------------------
# sentence-transformers (needs `pip install -e ".[ml]"`) or hashing (offline, dependency-free, lower quality)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Ingestion ------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=15

# ---- Retrieval ------------------------------------------------------------
TOP_K=5
MIN_SCORE=0.20
MAX_CONTEXT_CHARS=6000
ENABLE_QUERY_REWRITE=false
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Agent ----------------------------------------------------------------
AGENT_MAX_ITERATIONS=5

# ---- Storage --------------------------------------------------------------
DATA_DIR=./data

# ---- API / UI -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
# Optional shared secret. If set, the API requires the X-API-Key header (health check excluded).
NEXUS_API_KEY=
LOG_LEVEL=INFO
